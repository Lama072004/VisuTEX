{
  "name": "visutex",
  "private": true,
  "description": "VisuTeX – WYSIWYG-LaTeX-Editor mit eingebauter TeX-Engine",
  "license": "MIT",
  "author": "Mathias Lampert",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "typecheck": "tsc --noEmit",
    "i18n": "node scripts/i18n-check.mjs",
    "exe": "tauri build --no-bundle",
    "portable": "node scripts/portable.mjs",
    "portable:zip": "node scripts/portable.mjs --zip",
    "installer": "tauri build --bundles nsis",
    "installer:alle": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "katex": "^0.16.25",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
